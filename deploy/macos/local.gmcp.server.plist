<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.gmcp.server</string>
  <key>UserName</key>
  <string>gmcp</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gmcp/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/gmcp</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/gmcp/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gmcp/logs/server.err.log</string>
</dict>
</plist>
