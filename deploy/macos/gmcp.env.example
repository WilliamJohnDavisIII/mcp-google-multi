# /Users/gmcp/gmcp.env (0600, owner gmcp). Non-secret settings only; run.sh
# reads the client secret and both keys from their own 0600 files.

MCP_PUBLIC_URL=https://gmcp.davisregenerative.com
# The one Google address allowed through the connector's sign-in gate.
MCP_OWNER_EMAILS=liam@davisregenerative.com
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

GOOGLE_TOOLSETS=gmail,calendar,drive,docs,sheets,slides
GOOGLE_PROFILE=read-only
# M5: uncomment to allow drafts and calendar create/update (service:operation globs).
#GOOGLE_WRITE_ALLOW=gmail:create_draft,calendar:create_event,calendar:update_event
# Docs/Sheets/Slides fully; Drive create, edit, move, trash and comments. Permanent
# deletes and empty-trash stay refused because the read-only profile denies them.
GOOGLE_WRITE_ALLOW=docs:*,sheets:*,slides:*,drive:create,drive:update,drive:trash,drive:comment_delete,drive:reply_delete
# Deny wins over allow. Not *:delete*: that would also block deleting text in Docs and rows in Sheets.
GOOGLE_WRITE_DENY=gmail:send*,gmail:delete*,calendar:delete*,drive:share*,drive:*permission*,drive:access_proposal*,drive:*watch*
# Draft recipients, calendar attendees and Drive grantees: addresses and @domains.
GOOGLE_OUTBOUND_ALLOWLIST=@example.com
# Kill switch: uncomment and restart to refuse every write.
#GOOGLE_READ_ONLY=true

# Daily token check pings this (https://healthchecks.io check URL).
HEALTHCHECKS_URL=
